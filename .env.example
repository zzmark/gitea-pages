# Gitea Pages 配置
#
# 此文件中的变量统一以 PAGES_ 开头，避免与同目录其他 Compose 项目冲突。
# Compose 会将它们映射为容器内部所需的配置；请勿改用无前缀的旧变量名。

# ################### 必填 ###################

# 完整的 Pages 域名，例如 pages.example.com。
# 用户站点地址为：https://用户名.<此域名>/
PAGES_DOMAIN=pages.yourdomain.com

# ################### 可选 ###################

# 运行环境。生产环境请保持 production；仅本地开发可使用 development。
#PAGES_APP_ENV=production

# Nginx 对外暴露的宿主机端口。
#PAGES_HTTP_PORT=80

# Nginx 连接 Deployer 的内部地址，格式为 服务名:端口（不含 http://）。
# 更换 Compose 服务名或网络别名时可调整，例如 pages-deployer:8080。
#PAGES_DEPLOYER_UPSTREAM=deployer:8080

# 宿主机上已发布站点文件的目录。可以使用 volume 来替代此机制
#PAGES_DATA_DIR=./pages/webroot

# 容器运行用户的 UID/GID。PAGES_DATA_DIR 必须允许该用户读取/写入。
#PAGES_UID=1000
#PAGES_GID=1000

# Gitea 配置: 留空可在 /config 页面填写。运行配置以页面设定为准，修改 .env 不会覆盖。
# API地址
PAGES_GITEA_API_URL=

# 用户浏览器和 Git 克隆实际访问的 Gitea 地址。部署始终从此地址克隆；与 API 地址相同时无需设置。
PAGES_GITEA_PUBLIC_URL=

# 在 Gitea「设置 -> 应用 -> OAuth2 应用」中创建机密客户端后取得的 Client ID。
# 回调地址填写：https://<PAGES_DOMAIN>/oauth/callback
PAGES_OAUTH_CLIENT_ID=
PAGES_OAUTH_CLIENT_SECRET=

# 资源与部署限制。
PAGES_MAX_SITE_SIZE_MB=100
PAGES_MAX_REPOSITORY_SIZE_MB=1024
PAGES_MAX_CONCURRENT_DEPLOYS=4
PAGES_CLONE_TIMEOUT=1m
PAGES_ACQUIRE_TIMEOUT=30s

# 支持组织创建一个 webhook 后覆盖其下属仓库。
PAGES_ENABLE_ORGANIZATION_HOOKS=true
